---
/**
 * Layout comune: header con il logo e il menu del sito, contenuto, footer, meta Open Graph.
 * Il menu unisce la collection `pagine` (src/content/pagine/) con la voce "Documenti", che non è
 * un testo ma l'elenco dei PDF di public/documenti/ (vedi src/pages/documenti.astro).
 */
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/dm-mono/500.css';
import '../styles/base.css';
import logo from '../assets/loghi/logo-esteso.png';
import logoBadge from '../assets/loghi/logo-badge.png';
import Icona from '../components/Icona.astro';
import { getPagine, getPercorsi } from '../dati/astro';

interface Props {
  titolo: string;
  descrizione: string;
  /** Icona del percorso: sceglie il colore d'accento (vedi styles/token.css). */
  accento?: string;
}

const { titolo, descrizione, accento } = Astro.props;
const base = import.meta.env.BASE_URL;

const pagine = await getPagine();
const percorsi = await getPercorsi();
const voci = [
  ...pagine.map((p) => ({ slug: p.id, titolo: p.data.titolo, ordine: p.data.ordine })),
  { slug: 'documenti', titolo: 'Documenti', ordine: 2 },
].sort((a, b) => a.ordine - b.ordine);

const percorso = Astro.url.pathname;
const sonoIndirizzi = percorso !== base && !voci.some((v) => percorso === `${base}${v.slug}/`);

const immagine = new URL(logoBadge.src, Astro.site);
const canonico = new URL(percorso, Astro.site);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titolo}</title>
    <meta name="description" content={descrizione} />
    <link rel="canonical" href={canonico} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="IIS J.C. Maxwell — Quadri orari" />
    <meta property="og:title" content={titolo} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:url" content={canonico} />
    <meta property="og:image" content={immagine} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body data-accento={accento}>
    <a class="salta" href="#contenuto">Vai al contenuto</a>
    <header class="testata">
      <a href={base} class="testata__logo">
        <img src={logo.src} width={logo.width} height={logo.height} alt="IIS J.C. Maxwell — Quadri orari" />
      </a>
      <nav class="menu" aria-label="Sezioni del sito">
        <span class="menu__gruppo" data-tendina-gruppo>
          <a href={base} aria-current={sonoIndirizzi ? 'page' : undefined}>Indirizzi</a>
          <button
            type="button"
            class="menu__apri"
            hidden
            aria-expanded="false"
            aria-controls="tendina-indirizzi"
            aria-label="Scegli un indirizzo"
            data-tendina-pulsante
          >
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
              <path d="M2 4.5 6 8.5l4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </span>
        {
          voci.map((v) => (
            <a href={`${base}${v.slug}/`} aria-current={percorso === `${base}${v.slug}/` ? 'page' : undefined}>
              {v.titolo}
            </a>
          ))
        }
      </nav>
      <div class="tendina" id="tendina-indirizzi" hidden data-tendina-pannello>
        <ul>
          {
            percorsi.map(({ slug, percorso }) => (
              <li>
                <a
                  href={`${base}${slug}/`}
                  data-accento={percorso.icona}
                  aria-current={Astro.url.pathname === `${base}${slug}/` ? 'page' : undefined}
                >
                  <Icona nome={percorso.icona} class="tendina__icona" />
                  {percorso.nome}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="tendina__tutti" href={base}>Tutti gli indirizzi</a>
      </div>
    </header>
    <main id="contenuto">
      <slot />
    </main>
    <footer class="piede">
      <p>
        Istituto di Istruzione Superiore “J.C. Maxwell” ·
        <a href="https://www.jcmaxwell.edu.it/">Sito della scuola</a>
      </p>
    </footer>
    <script>
      import { avviaTendinaIndirizzi } from '../scripts/tendina-indirizzi';
      avviaTendinaIndirizzi();
    </script>
  </body>
</html>

<style>
  .salta {
    position: absolute;
    left: var(--margine);
    top: -100px;
    z-index: 10;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--inchiostro);
    color: var(--carta);
  }

  .salta:focus {
    top: 12px;
  }

  .testata {
    position: relative;
    padding-top: 18px;
  }

  .testata__logo {
    display: inline-block;
    padding: 0 var(--margine) 12px;
  }

  .testata img {
    display: block;
    height: 34px;
    width: auto;
  }

  .menu {
    display: flex;
    gap: 4px 20px;
    margin: 0;
    padding: 0 var(--margine) 14px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .menu a {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: var(--tocco);
    color: var(--tenue);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .menu a:hover {
    color: var(--inchiostro);
  }

  .menu a[aria-current='page'] {
    color: var(--accento-forte);
    border-bottom-color: var(--accento-forte);
  }

  .menu__gruppo {
    flex: none;
    display: inline-flex;
    align-items: center;
  }

  .menu__apri {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tocco);
    min-height: var(--tocco);
    margin-left: -6px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--tenue);
    cursor: pointer;
  }

  .menu__apri[hidden] {
    display: none;
  }

  .menu__apri:hover {
    color: var(--inchiostro);
  }

  .menu__apri svg {
    transition: transform 0.15s;
  }

  .menu__apri[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .tendina {
    position: absolute;
    z-index: 20;
    top: var(--y, 100%);
    left: var(--margine);
    right: var(--margine);
    padding: 6px;
    border: 1px solid var(--bordo);
    border-radius: var(--raggio);
    background: var(--carta);
    box-shadow: 0 12px 32px -12px rgb(31 32 35 / 0.28);
  }

  .tendina[hidden] {
    display: none;
  }

  .tendina ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tendina a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: var(--tocco);
    padding: 6px 12px;
    border-radius: 8px;
    color: var(--inchiostro);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .tendina a:hover {
    background: var(--carta-hover);
  }

  .tendina a[aria-current='page'] {
    background: var(--accento-tenue);
    color: var(--accento-forte);
  }

  .tendina :global(.tendina__icona) {
    flex: none;
    width: 32px;
    height: 24px;
    color: var(--accento);
  }

  .tendina .tendina__tutti {
    margin-top: 4px;
    border-top: 1px solid var(--bordo);
    border-radius: 0 0 8px 8px;
    padding-top: 4px;
    color: var(--tenue);
    font-size: 14px;
  }

  .piede {
    margin-top: 48px;
    padding: 24px var(--margine) 32px;
    border-top: 1px solid var(--bordo);
    font-size: 14px;
    color: var(--tenue);
  }

  .piede p {
    margin: 0;
  }

  @media (min-width: 960px) {
    .testata {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 8px 32px;
      padding: 20px var(--margine-largo);
      border-bottom: 1px solid var(--bordo);
    }

    .testata__logo {
      padding: 0;
    }

    .testata img {
      height: 48px;
    }

    .menu {
      gap: 8px 28px;
      padding: 0;
      overflow: visible;
    }

    .menu a {
      min-height: 0;
      font-size: 15px;
    }

    .menu__apri {
      width: 28px;
      min-height: 0;
      margin-left: 0;
    }

    .tendina {
      left: calc(var(--x, 0px) - 6px);
      right: auto;
      width: 300px;
    }

    .piede {
      padding-inline: var(--margine-largo);
    }
  }
</style>
