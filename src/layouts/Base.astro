---
/**
 * Layout comune: header con il logo, contenuto, footer. Favicon, meta Open Graph e menu di
 * navigazione arrivano con le pagine di contenuto (F6).
 */
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/dm-mono/500.css';
import '../styles/base.css';
import logo from '../assets/loghi/logo-esteso.png';

interface Props {
  titolo: string;
  descrizione: string;
  /** Icona del percorso: sceglie il colore d'accento (vedi styles/token.css). */
  accento?: string;
}

const { titolo, descrizione, accento } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titolo}</title>
    <meta name="description" content={descrizione} />
  </head>
  <body data-accento={accento}>
    <a class="salta" href="#contenuto">Vai al contenuto</a>
    <header class="testata">
      <a href={base} class="testata__logo">
        <img src={logo.src} width={logo.width} height={logo.height} alt="IIS J.C. Maxwell — Quadri orari" />
      </a>
    </header>
    <main id="contenuto">
      <slot />
    </main>
    <footer class="piede">
      <p>
        Istituto di Istruzione Superiore “J.C. Maxwell” ·
        <a href="https://www.jcmaxwell.edu.it/">Sito della scuola</a>
      </p>
    </footer>
  </body>
</html>

<style>
  .salta {
    position: absolute;
    left: var(--margine);
    top: -100px;
    z-index: 10;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--inchiostro);
    color: var(--carta);
  }

  .salta:focus {
    top: 12px;
  }

  .testata {
    padding: 18px var(--margine) 12px;
  }

  .testata__logo {
    display: inline-block;
  }

  .testata img {
    display: block;
    height: 34px;
    width: auto;
  }

  .piede {
    margin-top: 48px;
    padding: 24px var(--margine) 32px;
    border-top: 1px solid var(--bordo);
    font-size: 14px;
    color: var(--tenue);
  }

  .piede p {
    margin: 0;
  }

  @media (min-width: 960px) {
    .testata {
      padding: 20px var(--margine-largo);
      border-bottom: 1px solid var(--bordo);
    }

    .testata img {
      height: 48px;
    }

    .piede {
      padding-inline: var(--margine-largo);
    }
  }
</style>
